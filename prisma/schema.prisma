// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------- Models（DB 里不用 enum / Json，全部用 String 存状态） --------

// 老 WeCom 同步状态（先保留，将来不需要可以再删）
model KfSyncState {
  id        String   @id @default(cuid())
  openKfid  String   @unique
  token     String
  cursor    String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// VIP guest 基础信息（假的也可以放这里，方便 H5 / POC 测试）
model VipGuest {
  id            String   @id @default(cuid())

  // 用户在 H5 页面输入的 VIP number（唯一）
  vipNumber     String   @unique

  fullName      String
  preferredName String?

  // 用 String 存，比如 "Diamond" / "Gold"
  tier          String?

  // 生日（用于 vip-access 三项校验）
  birthday      DateTime?

  // 基本入住信息
  room          String?
  checkInDate   DateTime?
  checkOutDate  DateTime?
  segment       String?   // Business / Leisure ...
  statusLabel   String?   // Check in / Check out 等

  // 联系方式 / 渠道绑定（为以后微信 / WhatsApp 做准备）
  mobilePhone      String?  // 原始手机号（酒店系统里的 phone）
  whatsappNumber   String?  // 如需单独存 WhatsApp，用 E.164 也可以
  wechatId         String?  // 用户自己说的微信号（手动记录用）
  wechatOpenId     String?  // 以后如果接微信 OAuth，可以存 openid
  email            String?
  primaryLanguage  String?  // zh-CN / zh-HK / en 等
  preferredChannel String?  // "wechat" / "whatsapp" / "phone" 等

  // 喜好 / 忌讳（以后可以映射到 Chatwoot 的 custom_attributes）
  stayPreference           String? // 住宿偏好：房型、楼层、枕头、硬床/软床等
  diningPreference         String? // 饮食偏好 / 忌口 / 过敏
  transportPreference      String? // 出行偏好：车类型、司机语言等
  culturePrivacyPreference String? // 文化 / 隐私相关偏好（是否喜欢被打扰等）
  otherPreferences         String? // 其他偏好（原来的 notes 改名）

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 一个 VIP 可以有多次会话记录（旧 Session 表）
  sessions      Session[]

  // 一个 VIP 可以对应多条 PendingApproval 记录
  approvals     PendingApproval[]
}

// 一条「会话」= 一个 openKfId + 一个 externalUserId
// 对应前端的 Conversation（老 WeCom 逻辑，Chatwoot POC 目前可以不用）
model Session {
  id             String   @id @default(cuid())

  // 企业微信维度（H5 也可以复用这些字段做占位）
  openKfid       String
  externalUserId String

  // UI 需要的字段
  displayName    String?          // 对话顶部 / 列表里显示的名字

  // Channel：这里用 String 存，比如 "wechat" / "h5" / "whatsapp"
  channel        String  @default("wechat") // wechat / h5 / whatsapp / line ...

  lastMsgAt      DateTime?        // 用来排序（最新消息时间）
  lastMsgPreview String?          // 列表里显示的最后一条摘要
  unreadCount    Int      @default(0)

  // 用户在 H5 页面输入的 VIP 号（冗余一份，方便查）
  vipNumber      String?

  // 关联到 VipGuest（如果能匹配上）
  vipGuestId     String?
  vipGuest       VipGuest? @relation(fields: [vipGuestId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages       Message[]

  // 一个 openKfid + externalUserId 只对应一条会话
  @@unique([openKfid, externalUserId])

  // 快速按客服 + 最新时间排序
  @@index([openKfid, lastMsgAt])

  // 按 VIP 号查会话（后面 H5 用得到）
  @@index([vipNumber])
}

// 单条消息，对应前端的 Message
model Message {
  id             String   @id @default(cuid())

  // 企业微信原始字段（H5 也会复用这些字段做占位）
  msgId          String   @unique
  openKfid       String
  externalUserId String
  origin         String?  // 来源标记，比如 "wecom" / "h5"，可选
  msgType        String   // text / image / event ...
  sendTime       DateTime // 发送时间（WeCom 原始时间或 H5 创建时间）

  // 原来是 Json，这里用 String 存 JSON 字符串就好
  payload        String   // 比如存 JSON.stringify(payload)

  // 消息方向，这里用 String 存 "in" / "out"
  direction      String          // "in" / "out"，决定气泡朝向
  text           String?         // 纯文本内容（从 payload 里抽出来）

  // 关联到会话
  sessionId      String
  session        Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  // 常用查询索引
  @@index([openKfid, externalUserId, sendTime])
}

// 待人工审批的记录（无论是 WeCom 版还是 H5 版，都先写到这里）
model PendingApproval {
  id            String   @id @default(cuid())

  // 入口模式：wecom / h5（从哪个二维码来的）
  mode          String   // "wecom" | "h5"

  // 关联到 VipGuest（真正的酒店 VIP 记录）
  vipGuestId    String
  vipGuest      VipGuest @relation(fields: [vipGuestId], references: [id])

  // 冗余信息（方便查和展示）
  vipNumber     String
  preferredName String?
  birthday      DateTime?

  // 简单记录一下客户端信息，方便调试 / 平台识别
  platform      String?  // 例如 "wechat-browser" / "mobile-browser"
  userAgent     String?
  browserId     String?  // 前端生成的 uuid，识别同一个设备

  // 审批状态：用 String 存，比如 "PENDING" / "APPROVED" / "REJECTED"
  status        String   @default("PENDING")
  reason        String?  // 拒绝原因（可选）

  // 审批通过后绑定到 Chatwoot
  contactIdentifier String? // Chatwoot contact 的 source_id
  conversationId    Int?    // Chatwoot conversation 的 id

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 常用查询索引：按 VIP + 状态查、按模式 + 状态查
  @@index([vipNumber, status])
  @@index([mode, status])
}
