// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------- Models & Enums（DB 里不用 enum / Json，全部用 String） --------

// 用来存每个 OpenKfId 的同步状态（你之前就有的）
model KfSyncState {
  id        String   @id @default(cuid())
  openKfid  String   @unique
  token     String
  cursor    String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// VIP guest 基础信息（假的也可以放这里，方便 H5 测试）
model VipGuest {
  id            String   @id @default(cuid())

  // 用户在 H5 页面输入的 VIP number（唯一）
  vipNumber     String   @unique

  fullName      String
  preferredName String?

  // 原来是 VipTier enum，这里用 String 存，比如 "Diamond" / "Gold"
  tier          String?

  // 这些字段对应你 mockProfiles 里的信息，方便右侧 GuestProfilePanel 展示
  room          String?
  checkInDate   DateTime?
  checkOutDate  DateTime?
  segment       String?  // Business / Leisure ...
  statusLabel   String?  // Check in / Check out 等
  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 一个 VIP 可以有多次会话记录
  sessions      Session[]
}

// 一条「会话」= 一个 openKfId + 一个 externalUserId
// 对应前端的 Conversation
model Session {
  id             String   @id @default(cuid())

  // 企业微信维度
  openKfid       String
  externalUserId String

  // UI 需要的字段
  displayName    String?          // 对话顶部 / 列表里显示的名字

  // 原来是 Channel enum，这里用 String 存，比如 "wechat" / "whatsapp"
  channel        String  @default("wechat") // wechat / whatsapp / line ...

  lastMsgAt      DateTime?        // 用来排序（最新消息时间）
  lastMsgPreview String?          // 列表里显示的最后一条摘要
  unreadCount    Int      @default(0)

  // 用户在 H5 页面输入的 VIP 号（冗余一份，方便查）
  vipNumber      String?

  // 关联到 VipGuest（如果能匹配上）
  vipGuestId     String?
  vipGuest       VipGuest? @relation(fields: [vipGuestId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages       Message[]

  // 一个 openKfid + externalUserId 只对应一条会话
  @@unique([openKfid, externalUserId])

  // 快速按客服 + 最新时间排序
  @@index([openKfid, lastMsgAt])

  // 按 VIP 号查会话（后面 H5 用得到）
  @@index([vipNumber])
}

// 单条消息，对应前端的 Message
model Message {
  id             String   @id @default(cuid())

  // 企业微信原始字段
  msgId          String   @unique
  openKfid       String
  externalUserId String
  origin         String?  // 来源标记（比如 "wecom"），可选
  msgType        String   // text / image / event ...
  sendTime       DateTime // 企业微信那边的发送时间

  // 原来是 Json，这里用 String 存 JSON 字符串就好
  payload        String   // 比如存 JSON.stringify(payload)

  // 原来是 MessageDirection enum，这里用 String 存 "in" / "out"
  direction      String          // "in" / "out"，决定气泡朝向
  text           String?         // 纯文本内容（从 payload 里抽出来）

  // 关联到会话
  sessionId      String
  session        Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  // 常用查询索引
  @@index([openKfid, externalUserId, sendTime])
}
